// Copy this file to secrets.h (same folder) and fill in your WiFi.
// secrets.h is in .gitignore so your password never gets committed.
#pragma once
#define WIFI_SSID     "your-network-name"
#define WIFI_PASSWORD "your-network-password"

// Optional: fixed IP so IGS always finds the ESP32 at the same address.
// Uncomment all four lines and set them to match your network.
// Leave them commented out to get an address from your router (DHCP).
